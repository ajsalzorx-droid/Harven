# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large Assets — videos live on Cloudinary, not in git
/public/videos/
/Videos/
*.mp4

# Design source files & raw photos (keep locally, never commit — they made
# the repo ~280 MB and deploys timed out while cloning)
/IMAGES26/
/Products/
__MACOSX/
*.psd
*.eps
*.ai
/HARVEN-Profile.pdf
/public/brands/WhatsApp*

# One-off PDF extraction helpers
/read_pdf.js
/read_pdf.py
/pdf_text.txt
*.zip
*.png
*.svg
!/public/images/
!/public/brands/
!/public/**/*.png
!/public/**/*.svg

# Deployment folder (contains large video files)
/harven-deployment/

# Large video formats
*.mov
*.avi
*.mkv
